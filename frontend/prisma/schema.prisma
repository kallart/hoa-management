generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id             Int      @id @default(1)
  villageName    String
  commonAreaRate Float
  promptPay      String?
  cctvMapUrl     String?
  updatedAt      DateTime @updatedAt
}

model Property {
  id          String    @id @default(uuid())
  houseNumber String    @unique
  plot        String?
  landArea       Float
  ratePerYear    Float
  chargeInterest Boolean   @default(true)
  status         String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  invoices    Invoice[]
  owner       Owner?
}

model Owner {
  id         String   @id @default(uuid())
  propertyId String   @unique
  name       String
  phone      String?
  email      String?
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  fiscalYear    Int
  propertyId    String
  amount        Float
  arrears          Float     @default(0)
  interest         Float     @default(0)
  isInterestWaived Boolean   @default(false)
  commonFee        Float     @default(0)
  parkingFee    Float     @default(0)
  dueDate       DateTime
  status        String    @default("รอแจ้งค่าส่วนกลาง")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  property      Property  @relation(fields: [propertyId], references: [id])
  payments      Payment[]
}

model Payment {
  id              String   @id @default(uuid())
  invoiceId       String
  amount          Float
  paymentMethod   String
  referenceNumber String?
  slipUrl         String?
  receiptNumber   String?  @unique
  paymentDate     DateTime
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  tableName String
  recordId  String
  oldData   String?
  newData   String?
  userId    String?
  createdAt DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  description String
  houseNumber String?
  createdAt   DateTime @default(now())
}

model PoolWaterQuality {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  cl        Float
  ph        Float
  salt      Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CctvCamera {
  id            String               @id @default(uuid())
  cameraNumber  String               @unique
  location      String
  status        String               @default("normal")
  powerSource   String               @default("solar")
  warrantyStatus String?             @default("อยู่ในประกัน")
  issue         String?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  maintenanceLogs CctvMaintenanceLog[]
}

model CctvMaintenanceLog {
  id          String     @id @default(uuid())
  cameraId    String
  status      String
  description String
  createdAt   DateTime   @default(now())
  camera      CctvCamera @relation(fields: [cameraId], references: [id])
}

// --- Accounting Models ---

model AccountTransaction {
  id              String                  @id @default(uuid())
  docNumber       String                  @unique // e.g. PV-2569-0016, PC-2569-0286, RV-2569-0001
  manualRefNo     String?                 // เลขที่อ้างอิงเดิม เช่น #15, #285
  type            String                  // EXPENSE or INCOME
  subType         String                  // MONTHLY, REPAIR, PETTY_CASH, COMMON_FEE, PARKING, INTEREST, OTHER
  date            DateTime                @default(now())
  title           String                  // รายการ เช่น ค่าซ่อมแซมสายไฟ ระบบแสงสว่าง
  category        String?                 // หมวดหมู่
  payee           String?                 // ผู้รับเงิน / ผู้จ่ายเงิน เช่น ช่างศักดิ์ดา นาทันปอง
  payeePromptpay  String?                 // เลขพร้อมเพย์ / เลขบัญชี
  amount          Float
  paymentMethod   String                  @default("TRANSFER_MAIN") // TRANSFER_MAIN, PETTY_CASH, CASH
  status          String                  @default("PAID") // PAID, PENDING, CANCELLED
  notes           String?
  slipUrl         String?                 // รูปสลิปโอนเงิน
  idCardUrl       String?                 // รูปสำเนาบัตร ปชช. พร้อมเพย์+ลายเซ็น
  receiptUrl      String?                 // รูปใบเสร็จ / ใบกำกับภาษี
  workPhotos      String?                 // JSON string array ของรูปถ่ายหน้างาน
  driveUrl        String?                 // ลิงก์ Google Drive อ้างอิง
  replenishmentId String?                 // ผูกกับรอบการเบิกชดเชยเงินสดย่อย
  replenishment   PettyCashReplenishment? @relation(fields: [replenishmentId], references: [id])
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model ConstructionDeposit {
  id              String    @id @default(uuid())
  depositNumber   String    @unique // e.g. DEP-2569-001
  manualRefNo     String?   // เลขที่อ้างอิงเดิม
  houseNumber     String    // บ้านเลขที่ เช่น 405/12
  ownerName       String    // ชื่อเจ้าของบ้าน / ผู้ขอต่อเติม
  phone           String?
  amount          Float     // เช่น 10000
  depositDate     DateTime  @default(now())
  description     String?   // รายละเอียดงานต่อเติม
  slipUrl         String?   // สลิปเงินมัดจำ
  status          String    @default("HELD") // HELD, REFUNDED, DEDUCTED, FORFEITED
  deductedAmount  Float     @default(0)
  refundedAmount  Float     @default(0)
  refundDate      DateTime?
  refundSlipUrl   String?   // สลิปโอนคืนเงินมัดจำ
  inspectionNotes String?   // บันทึกตรวจหน้างาน
  driveUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model PettyCashReplenishment {
  id            String               @id @default(uuid())
  batchNumber   String               @unique // e.g. PCR-2569-10-001
  amount        Float                // ยอดเงินที่เบิกชดเชย
  replenishDate DateTime             @default(now())
  slipUrl       String?              // สลิปโอนเงินเข้ากองเงินสดย่อย
  notes         String?
  transactions  AccountTransaction[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model AccountingSetting {
  id             String   @id @default(uuid())
  pettyCashLimit Float    @default(5000) // วงเงินสดย่อยเริ่มต้น 5,000 บาท
  nextPvNumber   Int      @default(16)   // เริ่มต้นที่ 16 ต่อจาก #15
  nextPcNumber   Int      @default(286)  // เริ่มต้นที่ 286 ต่อจาก #285
  nextDepNumber  Int      @default(1)
  googleDriveUrl String?
  updatedAt      DateTime @updatedAt
}
